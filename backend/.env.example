# Copy this file to .env and put your real key there. NEVER commit .env
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FLASK_DEBUG=0
# Websites allowed to call this API (comma separated). Use your Vercel URL in production.
ALLOWED_ORIGINS=*
